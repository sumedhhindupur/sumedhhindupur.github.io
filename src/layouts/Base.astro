---
import '../styles/global.css';
import { site } from '../data/site';

// `plain` switches to the bare-bones look (see the end of global.css); `home` is where the name and Research links point.
interface Props { title?: string; description?: string; math?: boolean; plain?: boolean; home?: string }
const { title, description = 'Sumedh Hindupur: representation geometry, interpretability and computational neuroscience.', math = false, plain = false, home = '/' } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const path = Astro.url.pathname;
// Set when the site is built, i.e. on every push.
const updated = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <!-- Link previews (Slack, X, LinkedIn, iMessage): public/og.png is a 1200x630 card -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- To change fonts, replace this link and the variables at the top of src/styles/global.css -->
    <link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..700;1,300..700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    {math && <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />}
    <!-- Private visitor stats (no cookies): https://sumedhhindupur.goatcounter.com -->
    <script is:inline data-goatcounter="https://sumedhhindupur.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
  </head>
  <body class:list={{ plain }}>
    <header class="container nav">
      <a href={home} class="brand">{site.name}</a>
      <nav>
        <a href={`${home}#research`}>Research</a>
        <a href="/writing/" class={path.startsWith('/writing') ? 'active' : ''}>Writing</a>
        <a href="/cv.pdf">CV</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="container">
      <span class="mono">© {new Date().getFullYear()} {site.name} · Last updated {updated}</span>
    </footer>
    <script>
      // The address is assembled only when someone points at, focuses or taps the link, so it never
      // appears in the page source; after that it is an ordinary mailto: link.
      document.querySelectorAll<HTMLAnchorElement>('a.js-email').forEach((a) => {
        const arm = () => { a.href = 'mailto:' + a.dataset.u + '@' + a.dataset.d; };
        ['mouseenter', 'focus', 'touchstart', 'mousedown'].forEach((ev) => a.addEventListener(ev, arm, { passive: true }));
      });
    </script>
  </body>
</html>

<style>
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 22px;
    padding-bottom: 22px;
  }
  .brand { color: var(--text); font-weight: 600; letter-spacing: -0.01em; }
  .brand:hover { text-decoration: none; }
  nav { display: flex; gap: 26px; font-size: 17px; }
  nav a { color: var(--muted); }
  nav a:hover, nav a.active { color: var(--text); text-decoration: none; }
  footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 28px;
    padding-bottom: 40px;
    border-top: 1px solid var(--rule);
  }
</style>
