---
// The Writing page: Research | Personal tabs plus the post list for one category.
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

interface Props { category: 'research' | 'personal' }
const { category } = Astro.props;

const posts = (await getCollection('writing', (p) =>
  p.data.category === category && (import.meta.env.DEV || !p.data.draft)
)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<Base title="Writing">
  <div class="container">
    <h1>Writing</h1>
    <div class="tabs">
      <a href="/writing/" class={category === 'research' ? 'on' : ''}>Research</a>
      <a href="/writing/personal/" class={category === 'personal' ? 'on' : ''}>Personal</a>
    </div>
    {posts.length === 0
      ? <p class="empty">First posts coming soon.</p>
      : <ul>
          {posts.map((p) => (
            <li>
              <span class="mono">{fmt(p.data.date)}</span>
              <div>
                <a href={`/writing/${p.slug}/`}>{p.data.title}</a>
                {p.data.draft && <span class="mono"> · draft</span>}
                {p.data.description && <p>{p.data.description}</p>}
              </div>
            </li>
          ))}
        </ul>}
  </div>
</Base>

<style>
  h1 { font-size: 34px; font-weight: 600; letter-spacing: -0.02em; margin: 40px 0 18px; }
  .tabs { display: flex; gap: 24px; border-bottom: 1px solid var(--rule); margin-bottom: 24px; }
  .tabs a { color: var(--muted); padding: 8px 0; margin-bottom: -1px; border-bottom: 2px solid transparent; }
  .tabs a:hover { text-decoration: none; color: var(--text); }
  .tabs a.on { color: var(--text); border-bottom-color: var(--text); }
  ul { list-style: none; padding: 0; margin: 0 0 60px; }
  li { display: grid; grid-template-columns: 110px 1fr; gap: 16px; padding: 10px 0; align-items: baseline; }
  li a { color: var(--text); font-weight: 500; }
  li p { margin: 2px 0 0; color: var(--muted); font-size: 16.5px; }
  .empty { color: var(--muted); margin-bottom: 80px; }
  @media (max-width: 640px) { li { grid-template-columns: 1fr; gap: 0; } }
</style>
