---
{name in filled
  ? <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={filled[name]} /></svg>
  : <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={outline[name]} />}

<style>
  .icon { width: 1em; height: 1em; flex: none; }
</style>
