---
// Renders one blog post.
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('writing', (p) => import.meta.env.DEV || !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const date = post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const back = post.data.category === 'research' ? '/writing/' : '/writing/personal/';
---
<Base title={post.data.title} description={post.data.description} math>
  <article class="container post">
    <p class="mono"><a href={back}>← Writing</a></p>
    <h1>{post.data.title}</h1>
    <p class="mono">{date}</p>
    <div class="body"><Content /></div>
  </article>
</Base>

<style>
  .post { max-width: 680px; padding-bottom: 60px; }
  h1 { font-size: 34px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; margin: 28px 0 8px; }
  .body { margin-top: 32px; font-size: 17.5px; line-height: 1.7; }
  .body :global(h2) { font-size: 22px; font-weight: 600; margin: 40px 0 8px; }
  .body :global(h3) { font-size: 18px; font-weight: 600; margin: 28px 0 6px; }
  .body :global(img), .body :global(video) { max-width: 100%; border-radius: 6px; }
  .body :global(figure) { margin: 28px 0; }
  .body :global(figcaption) { font-size: 14px; color: var(--muted); margin-top: 6px; }
  .body :global(code) { font-family: var(--font-mono); font-size: 0.85em; background: var(--surface); padding: 1px 5px; border-radius: 4px; }
  .body :global(pre) { background: var(--surface); padding: 16px; border-radius: 6px; overflow-x: auto; font-size: 14px; }
  .body :global(pre code) { background: none; padding: 0; }
  .body :global(blockquote) { margin: 20px 0; padding-left: 16px; border-left: 2px solid var(--rule); color: var(--muted); }
  .body :global(.katex-display) { overflow-x: auto; overflow-y: hidden; }
</style>
